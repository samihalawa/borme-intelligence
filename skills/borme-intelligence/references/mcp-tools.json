{
  "server": "borme-intelligence",
  "version": "0.4.0",
  "tools": [
    {
      "name": "borme_company_notices",
      "title": "borme company notices",
      "description": "Find corporate-name matches in one province's BORME registered-acts issue. Preserves official records; not a complete company history or credit assessment.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "date": {
            "type": "string"
          },
          "province": {
            "type": "string",
            "default": "MADRID"
          },
          "limit": {
            "type": "integer",
            "default": 20
          }
        },
        "required": [
          "company",
          "date"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "borme_company_range",
      "title": "borme company range",
      "description": "Inspect one company/province over up to seven explicit days, preserving missing issues and failures. User-initiated lookup, not monitoring.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "start_date": {
            "type": "string"
          },
          "end_date": {
            "type": "string"
          },
          "province": {
            "type": "string",
            "default": "MADRID"
          },
          "limit": {
            "type": "integer",
            "default": 20
          }
        },
        "required": [
          "company",
          "start_date",
          "end_date"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": true
      }
    },
    {
      "name": "borme_events",
      "title": "borme events",
